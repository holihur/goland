# Development defaults are shown. Production must override passwords and keys.
GOLAND_ADDR=127.0.0.1:8788
GOLAND_MONGO_URI=mongodb://127.0.0.1:27019
GOLAND_MONGO_DB=goland
GOLAND_WORKSPACE_ROOTS=/root/goland/.data/workspaces
GOLAND_SESSION_TTL=168h
GOLAND_ADMIN_EMAIL=admin@goland.local
GOLAND_ADMIN_PASSWORD=admin123456
GOLAND_ADMIN_NAME=Administrator
# 32 random bytes, base64. Leave empty in development to auto-generate .data/master.key.
GOLAND_MASTER_KEY=
GOLAND_SECURE_COOKIES=false
GOLAND_WEB_DIST=
# Optional explicit language tool binaries. Defaults use PATH.
GOLAND_GOPLS=gopls
GOLAND_TSSERVER=typescript-language-server
GOLAND_DLV=dlv
GOLAND_NODE=node
GOLAND_JS_DEBUG=deploy/js-debug/src/dapDebugServer.js
GOLAND_CHROME=/root/.cache/ms-playwright/chromium-1255/chrome-linux64/chrome
# Require TOTP MFA for every account. Users enroll after password login.
GOLAND_MFA_REQUIRED=false
# Public base URL used for OIDC redirects when no explicit redirect is set.
GOLAND_PUBLIC_URL=
# Optional OpenID Connect single sign-on.
GOLAND_OIDC_ISSUER=
GOLAND_OIDC_CLIENT_ID=
GOLAND_OIDC_CLIENT_SECRET=
GOLAND_OIDC_REDIRECT_URL=
GOLAND_OIDC_NAME=Single sign-on
GOLAND_OIDC_SCOPES=openid,profile,email
GOLAND_OIDC_AUTO_CREATE=false
# Treat a successful OIDC login as satisfying the local MFA policy.
GOLAND_OIDC_TRUST_MFA=true
GOLAND_OIDC_REQUIRE_VERIFIED_EMAIL=true
