# Copy to deploy/.env and change these before exposing the service.
GOLAND_PORT=8080
GOLAND_ADMIN_EMAIL=admin@goland.local
GOLAND_ADMIN_PASSWORD=change-me-to-a-long-password
GOLAND_ADMIN_NAME=Administrator
GOLAND_SECURE_COOKIES=false
GOLAND_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
